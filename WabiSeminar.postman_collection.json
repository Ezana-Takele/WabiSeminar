        {
          "name": "Send Message to Chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello from Postman!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meetings",
                "{{meetingId}}",
                "messages"
              ]
            }
          }
        }
      ]
