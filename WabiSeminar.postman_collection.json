              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"option_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/polls/1/vote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meetings",
                "{{meetingId}}",
                "polls",
                "1",
                "vote"
              ]
            }
          }
        },
        {
          "name": "Get Poll Results",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/polls/1/results",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meetings",
                "{{meetingId}}",
                "polls",
                "1",
                "results"
              ]
            }
          }
        }
