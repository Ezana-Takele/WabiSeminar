    {
      "name": "5. Meeting Polls",
      "item": [
        {
          "name": "Get All Polls in Meeting",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
