                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Which presentation format do you prefer?\",\n  \"options\": [\n    \"Slide deck + Live demo\",\n    \"Interactive QA only\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/polls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meetings",
                "{{meetingId}}",
                "polls"
              ]
            }
          }
        },
        {
          "name": "Vote on Poll",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
