{
  "info": {
    "name": "WabiSeminar API",
    "description": "Postman collection for testing WabiSeminar REST API endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "meetingId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"tester@wabiseminar.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@wabiseminar.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Meetings",
      "item": [
        {
          "name": "Get All Meetings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/meetings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meetings"
              ]
            }
          }
        },
        {
          "name": "Get Single Meeting by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meetings",
                "{{meetingId}}"
              ]
            }
          }
        },
        {
          "name": "Create New Meeting",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"host_id\": 1,\n  \"title\": \"Postman Verified Seminar\",\n  \"description\": \"Interactive demo meeting created from Postman\",\n  \"date\": \"2026-08-30\",\n  \"time\": \"04:00 PM\",\n  \"duration\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meetings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meetings"
              ]
            }
          }
        },
        {
          "name": "Join Meeting",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/join",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meetings",
                "{{meetingId}}",
                "join"
              ]
            }
          }
        },
        {
          "name": "Get Meeting Participants",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/participants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meetings",
                "{{meetingId}}",
                "participants"
              ]
            }
          }
        },
        {
          "name": "Leave Meeting",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/meetings/{{meetingId}}/leave",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "meetings",
                "{{meetingId}}",
                "leave"
              ]
            }
          }
        }
      ]
    },
